# KrishiVaani Frontend Environment Configuration Example
# Copy to .env.local for local overrides. In standard dev mode, Vite reverse proxies to localhost:5001.

# Optional: Custom API Base URL (leave empty or unset to use standard relative reverse proxy /api/v1)
# VITE_API_BASE_URL=https://api.krishivaani.example.com/api/v1

# Supabase browser client (used for session persistence and API bearer tokens)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
