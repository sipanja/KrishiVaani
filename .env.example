# KrishiVaani AI - Environment Configuration Example
# Copy this file to .env and configure real credentials. Never commit .env to source control.

# Flask Application
FLASK_ENV=development
FLASK_APP=backend.wsgi:app
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
PORT=5000

# Database
# Production: postgresql://krishivaani:password@postgres:5432/krishivaani_db
# Local dev default: sqlite:///krishivaani.db
DATABASE_URL=sqlite:///krishivaani.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Gnani AI Credentials (Real Indian Voice Engine)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Weather Configuration
# IMD / Open-Meteo Integration (No API key required for Open-Meteo standard endpoints)
WEATHER_SOURCE=open-meteo-imd
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090

# Storage for Crop Photos
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=5242880 # 5 MB

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Follow-up Engine
ENABLE_BACKGROUND_SCHEDULER=true
QUIET_HOURS_START=21 # 9 PM
QUIET_HOURS_END=6    # 6 AM
